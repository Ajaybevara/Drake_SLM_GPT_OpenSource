# OpenAI-compatible local/LAN vLLM server for chat and vision
VLLM_API_BASE=http://192.168.1.100:8700/v1
VLLM_API_KEY=empty
VLLM_MODEL=qwen3-vl-8b
VLLM_TIMEOUT_SECONDS=300

# CPU-hosted embedding model on the Windows application computer
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LOCAL_EMBEDDING_DIM=768
LOCAL_EMBEDDING_CACHE=database/model_cache

# Prevent LiteLLM from fetching external pricing metadata
LITELLM_LOCAL_MODEL_COST_MAP=True

# Dedicated local PostgreSQL database
DATABASE_URL=postgresql://drake@127.0.0.1:5433/drake_ai
